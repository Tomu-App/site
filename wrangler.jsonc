{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomu-site",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_als"],
  "main": "src/worker.ts",
  "alias": { "sveltekit-worker": "./.svelte-kit/cloudflare/_worker.js" },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tomu-site",
      "database_id": "7dce7b74-f8c8-4941-9799-a045d1b84a4a",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "BASE_URL": "https://tomu.foo", "MAIL_FROM": "hallo@tomu.foo" },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hallo@tomu.foo"] }],
  "ratelimits": [
    { "name": "SIGNUP_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
  ],
  "secrets": { "required": ["TURNSTILE_SECRET", "JWT_SECRET"] },
  "triggers": { "crons": ["0 3 * * *"] },
  "routes": [{ "pattern": "tomu.foo", "custom_domain": true }],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "workers_dev": false,
  "preview_urls": false,
}
