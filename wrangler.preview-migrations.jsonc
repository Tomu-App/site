{
  // Used only to apply D1 migrations to the shared Preview database before a Preview deploy:
  //   wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc
  // database_name and database_id must match previews.d1_databases in wrangler.jsonc.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomu-site",
  "d1_databases": [
    {
      "binding": "PREVIEW_DB",
      "database_name": "tomu-site-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
