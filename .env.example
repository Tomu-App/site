# Copy to .env.local (development values, the only file `vite dev` / `wrangler dev` use) and
# .env.production (production values, loaded by Vite only for builds; local only, never committed;
# push to Cloudflare with `pnpm exec wrangler secret bulk .env.production`). Do not create a plain
# .env: Vite loads it in every mode, development included.
# Turnstile test secret that always passes: 1x0000000000000000000000000000000AA
JWT_SECRET=
TURNSTILE_SECRET=
# Public Turnstile site key, inlined at build time (use the real key in .env for production builds).
# Empty = Turnstile test key that always passes: 1x00000000000000000000AA
# Builds with REQUIRE_PROD_CONFIG=1 (the production deploy workflow) FAIL when empty; CI, dev and tests never fail.
# In GitHub Actions this is the repo variable TURNSTILE_SITE_KEY.
TURNSTILE_SITE_KEY=
