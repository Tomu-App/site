# Copy to .env (production values, local only, never committed; push to Cloudflare with
# `pnpm exec wrangler secret bulk .env`) and/or .env.local (development overrides,
# loaded over .env by `wrangler dev` / `vite dev`).
# Turnstile test secret that always passes: 1x0000000000000000000000000000000AA
JWT_SECRET=
TURNSTILE_SECRET=
